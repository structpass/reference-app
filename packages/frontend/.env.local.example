# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# 環境識別バッジ（header に表示）。production では空 or "production" にする
# development / staging / production を想定
NEXT_PUBLIC_APP_ENV=development

# Branding（login 画面・サイドバー・<title> で参照）
NEXT_PUBLIC_APP_NAME=Struct Pass
NEXT_PUBLIC_APP_SUBTITLE=商品管理システム

# グローバルメニュー: ヘッダのタブナビが遷移する Rete のベース URL。
# 任意（未設定時は http://localhost:3010）。譲渡先では Rete の公開 URL に差し替える
NEXT_PUBLIC_RETE_URL=http://localhost:3010

# ref-0037: Rete backend の API ベース URL。ログイン確定後に表示個人設定（縞模様）を直接 fetch する。
# 任意（未設定時は http://localhost:3011/api/v1）。譲渡先では Rete backend の公開 URL に差し替える
NEXT_PUBLIC_RETE_API_URL=http://localhost:3011/api/v1
