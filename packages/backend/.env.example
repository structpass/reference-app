# Copy this file to .env and fill in all required values.
# NEVER commit the actual .env file to version control.

# ============================================================
# Database (REQUIRED)
# ============================================================
# Replace <user>, <password>, <host>, <dbname> with real values.
#
# 接続プールの上限は URL のクエリで明示する（Prisma 既定に任せない）。未指定だと起動時に警告が出る
# （本番は起動を拒否する＝common/config/env-validation.ts の validateDatabasePoolLimits・ref-0071）。
#   connection_limit=5  … このプロセスの Prisma が張る最大接続数（2 vCPU 相当の 2*N+1）。上限が無いと
#                         DB 側の max_connections を食い潰す。
#   pool_timeout=70     … 通常クエリがプールの空きを待つ秒数。超えると Prisma が P2024 を投げ、
#                         PrismaExceptionFilter が 503 + Retry-After へ写像する（0＝無限待ちは拒否）。
#                         値は最長のトランザクション上限（商品一括取込の 60 秒・
#                         products.repository.ts）より長く取る＝短いと、取込を握っている側が自分の
#                         上限に達する前に、無関係なリクエストが先に 503 になる。
#                         なお interactive transaction の接続待ちは本値ではなく maxWait
#                         （一括取込は 10 秒）が先に切り、その時のコードは P2024 ではなく P2028
#                         （写像先は同じ 503 + Retry-After）。
# 注意（接続数の勘定）: reference はログイン状態を JWT cookie で持ち DB の session ストアを使わない
# ため、1 インスタンスの実消費は本体の connection_limit=5 のみ。インスタンスを増やす時は
# インスタンス数 × connection_limit が DB の max_connections を超えないよう見直す。
# 検査の適用範囲: アプリ本体の起動時（main.ts・本番は fail-fast / dev は警告）と seed（警告のみ）で、
# migrate は検査の hook 点が無いため適用範囲外（operational-policy §4・ref-0071）。
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public&connection_limit=5&pool_timeout=70"

# ============================================================
# JWT (REQUIRED)
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters. Must be changed from this placeholder before starting.
JWT_SECRET="CHANGE_ME_generate_a_random_64_char_hex_string"
JWT_EXPIRES_IN="1d"

# ============================================================
# Application
# ============================================================
PORT=3001
NODE_ENV=development

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins in production.
CORS_ORIGIN="http://localhost:3000"

# ============================================================
# OIDC (SSO / Rete = Identity Provider) — REQUIRED
# ============================================================
# reference は rete(IdP) とセットで稼働する RP。rete 起動後、以下 4 つは必須（起動時に検証）。
# SSO は rete と reference を同時起動するため、同一ホストでは両 backend のポートを分ける
# （単体既定はどちらも 3001。共存時は rete 側 PORT をずらす想定。例は rete=3011）。
OIDC_ISSUER="http://localhost:3011/api/v1/oidc"
# rete に登録した client_id と一致させる（rete 側 OIDC_REFERENCE_CLIENT_ID）。
OIDC_CLIENT_ID="struct-pass-reference"
# rete 側 OIDC_REFERENCE_CLIENT_SECRET と同一のランダム値。placeholder のまま本番に流出させない。
OIDC_CLIENT_SECRET="CHANGE_ME_must_match_rete_OIDC_REFERENCE_CLIENT_SECRET"
# このアプリ(reference) backend の callback。rete 側 redirect_uris に同値を登録する。
OIDC_REDIRECT_URI="http://localhost:3001/api/v1/auth/oidc/callback"
# OIDC callback 成功/失敗後の redirect 先（frontend origin）。production では必須（未設定は起動時エラー）。
# dev では未設定時 CORS_ORIGIN の先頭値へ fallback するため省略可。
# CORS_ORIGIN（許可 origin の別関心事）を redirect 先に流用しない（設定漏れ時の phishing origin 防止）。
OIDC_FRONTEND_URL="http://localhost:3000"
# 初期管理者の sub（= rete Account.id = reference User.oidcSub）。両 repo の seed 既定と一致させる。
# 譲渡・本番では両 repo を同一の新規 uuid に差し替える（鍵の引き渡し）。
# 本番では prisma/bootstrap-admin.mjs がこの SUB で SYS_ADMIN を作る（ref-0086・SUB 未設定時は bootstrap skip）。
BOOTSTRAP_ADMIN_SUB="00000000-0000-4000-a000-000000000001"
# 本番 bootstrap の初期管理者 email（SUB 指定時は必須・ref-0086）。
BOOTSTRAP_ADMIN_EMAIL=""
# 本番 bootstrap の初期管理者表示名（省略時は email を流用・ref-0086）。
BOOTSTRAP_ADMIN_NAME=""

# ============================================================
# サービス連携（rete → reference 機械認証・ref-0095）
# ============================================================
# rete backend が ObjectType 一覧を取得するための共有 credential（secret 扱い）。
# 本番は 32 文字以上。未設定時は受口が fail-closed で常に拒否（連携だけ無効化）。
# 生成: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
INTEGRATION_SERVICE_TOKEN="CHANGE_ME_generate_a_random_64_char_hex_string"

# ============================================================
# リバースプロキシ（任意・既定 off）
# ============================================================
# Caddy などのリバースプロキシ 1 段配下でのみ true に設定する（trust proxy hops=1 有効化）。
# 有効時はレート制限が実クライアント IP 単位になる（本番 compose は既定で有効）。
# 直結起動（開発）では未設定 or false のまま: 有効だと偽の X-Forwarded-For で制限回避が可能になるため。
# 値は true 固定（CIDR 等の自由値は受け付けない）。
TRUST_PROXY="false"
