{
  "name": "@struct-pass/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Struct Pass リファレンス実装 - 商品管理システム",
  "scripts": {
    "dev": "pnpm --filter @struct-pass/backend prisma:generate && pnpm --filter @struct-pass/shared build && pnpm --parallel --filter \"./packages/**\" dev",
    "build": "pnpm --filter \"./packages/**\" build",
    "lint": "pnpm --filter \"./packages/**\" lint",
    "format": "pnpm --filter \"./packages/**\" format",
    "format:check": "prettier --check .",
    "check:node-version": "node scripts/check-node-version.mjs",
    "check:ci-wiring": "node scripts/check-ci-wiring.mjs",
    "check:e2e-preflight": "node scripts/e2e-preflight.mjs",
    "check:migration-history": "node scripts/check-migration-history.mjs",
    "check:migration-preconditions": "node scripts/check-migration-preconditions.mjs",
    "test": "pnpm --filter \"./packages/**\" test",
    "test:security": "node --test scripts/check-magicast-patch.test.mjs",
    "test:ci-wiring": "node --test scripts/check-ci-wiring.test.mjs",
    "test:e2e-preflight": "node --test scripts/e2e-preflight.test.mjs",
    "test:migration-history": "node --test scripts/check-migration-history.test.mjs scripts/check-migration-preconditions.test.mjs",
    "repair:migration-history": "node scripts/repair-migration-history.mjs",
    "test:type-check": "node --test scripts/type-check.test.mjs",
    "test:cov": "pnpm --filter \"./packages/**\" test:cov",
    "clean": "pnpm --filter \"./packages/**\" clean && rm -rf node_modules"
  },
  "keywords": [
    "struct-pass",
    "reference-implementation",
    "product-management",
    "enterprise"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/node": "^20.17.10",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@>=3": "^5.0.12",
      "deepmerge-ts@>=7": "^8.0.1",
      "defu@>=6": "^6.1.5",
      "effect@>=3": "^3.20.0",
      "fast-uri": "^4.1.2",
      "flatted@>=3": "^3.4.2",
      "form-data@>=4": "^4.0.6",
      "js-yaml@>=3 <4": "^3.15.2",
      "js-yaml@>=4": "^4.3.2",
      "lodash": "^4.18.1",
      "multer": "^2.5.0",
      "tmp": "^0.2.7",
      "picomatch@<2.3.2": ">=2.3.2 <3.0.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "flatted@<=3.4.1": ">=3.4.2",
      "defu@<=6.1.4": ">=6.1.5",
      "effect@<3.20.0": ">=3.20.0",
      "undici@7": "^7.30.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "js-yaml@5": "^5.4.1",
      "postcss@8": "^8.5.18",
      "ws@8": "^8.21.0",
      "form-data@4": "^4.0.6",
      "fast-uri@3": "^3.1.9",
      "ajv@8": "^8.18.0",
      "qs@6": "^6.16.1",
      "body-parser@2": "^2.4.0",
      "sharp": "^0.35.5",
      "uuid": "^11.1.1",
      "@babel/core@7": "^7.29.6",
      "protobufjs@7": "^7.6.5",
      "nanoid@^3": "^3.3.18",
      "path-to-regexp@<1": "^0.1.13",
      "path-to-regexp@>=8": "^8.4.0",
      "picomatch@<3": "^2.3.2",
      "picomatch@>=4": "^4.0.4",
      "postcss-selector-parser@6": "^6.1.5",
      "postcss@>=8": "^8.5.18",
      "sharp@>=0.34": "^0.35.5",
      "ws@>=8": "^8.21.0",
      "@grpc/grpc-js": "^1.14.5",
      "@humanfs/node": "^0.16.8",
      "baseline-browser-mapping": "^2.11.0",
      "browserslist": "^4.28.7",
      "handlebars": "^4.7.10",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "follow-redirects@>=1.16.0 <1.16.2": "^1.16.2",
      "vite@>=7.0.0 <=7.3.6": "^7.3.7",
      "minimatch": "^11.0.3",
      "glob@>=9": "^14.0.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gcqx-w48m-w2h4"
      ]
    },
    "patchedDependencies": {
      "magicast@0.5.5": "patches/magicast@0.5.5.patch"
    }
  }
}
