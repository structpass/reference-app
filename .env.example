# 開発用の環境変数。docker compose はこのディレクトリの .env を自動で読む。
#   cp .env.example .env
# 開発機のローカル専用の値。本番の値は .env.production.example と docker-compose.prod.yml を使う。
# docker compose は指定したサービス以外の行も展開するため、postgres だけ起動する時も
# POSTGRES_PASSWORD と JWT_SECRET の2つが要る。

POSTGRES_USER=postgres

# 既定値は持たせていない（未設定なら compose が起動前に停止する）。この値が効くのはコンテナの
# 初回作成（initdb）時だけなので、既に開発 DB のボリュームがある機では作成時のパスワードが残る。
# その場合は packages/backend/.env の DATABASE_URL に書かれている値をここへ入れる。
POSTGRES_PASSWORD=CHANGE_ME_dev_db_password
POSTGRES_DB=struct_pass_dev

# 開発用 compose の backend サービスが参照する。通常の開発は pnpm dev で起動するため未使用だが、
# compose はファイル全体を展開するので値が要る。
JWT_SECRET=CHANGE_ME_dev_only_jwt_secret_at_least_32_chars
